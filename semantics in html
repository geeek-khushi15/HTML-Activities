<!DOCTYPE html>
<html>
<head>
    <title>Semantics in HTML Activity</title>
</head>
<body>

    <!-- Header section usually contains the logo or main heading -->
    <header>
        <h1>My Awesome Website</h1>
        <!-- Nav is used for navigation links -->
        <nav>
            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <!-- Main contains the primary content of the page -->
    <main>
        <!-- Section is used to group related content -->
        <section id="home">
            <h2>Welcome to my Page</h2>
            <p>This page is built using semantic HTML tags to make the structure clear.</p>
        </section>

        <!-- Article is for independent, self-contained content -->
        <article>
            <h2>What is Semantic HTML?</h2>
            <p>Semantic HTML introduces meaning to the web page rather than just presentation. It helps search engines and screen readers understand the content better.</p>
        </article>

        <!-- Aside is used for content tangentially related to the main content (like a sidebar) -->
        <aside>
            <h3>Fun Fact</h3>
            <p>Using semantic tags makes your website more accessible!</p>
        </aside>
    </main>

    <!-- Footer contains footer information like copyrights or author info -->
    <footer>
        <p>&copy; 2026 My Awesome Website. All rights reserved.</p>
    </footer>

</body>
</html>
